{
  "name": "logseq-dev",
  // GitHub's universal Codespaces image. Ships sshd, Node 22, Java 21,
  // Clojure CLI, pnpm via corepack, and the rest of the standard dev
  // toolchain. Cached on Codespaces hosts, so cold start is fast despite
  // the size.
  "image": "mcr.microsoft.com/devcontainers/universal:2",

  // Pin pnpm, install the Clojure CLI (universal:2 has Java 21 + Node 22
  // but no clj), and install JS deps. Runs once on container creation.
  "postCreateCommand": "bash -c 'set -e; corepack enable; corepack prepare pnpm@10.33.0 --activate; if ! command -v clojure >/dev/null; then curl -fsSL https://download.clojure.org/install/linux-install-1.12.0.1530.sh -o /tmp/clj.sh; chmod +x /tmp/clj.sh; sudo /tmp/clj.sh; fi; pnpm install --frozen-lockfile'",

  // Every start: launch the watch pipeline in a new session that survives
  // the agent cleanup. The agent runs this via /bin/sh -c (dash). Plain
  // `nohup ... &` gets reaped when the agent's shell exits; setsid -f
  // forks into a new session so the watch process keeps running.
  "postStartCommand": "/bin/sh -c 'cd /workspaces/logseq && rm -f /tmp/dev.log && setsid -f sh -c \"exec pnpm watch >>/tmp/dev.log 2>&1\" </dev/null'",

  "forwardPorts": [3001],
  "portsAttributes": {
    "3001": {
      "label": "Logseq dev (live-reload)",
      "onAutoForward": "openPreview",
      // Codespaces-specific: bakes the port forward at public visibility
      // so anyone with the URL can hit it without a GH session.
      "visibility": "public"
    }
  },

  "hostRequirements": { "cpus": 8, "memory": "32gb", "storage": "64gb" }
}
